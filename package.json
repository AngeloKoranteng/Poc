{
  "name": "foto-styler",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "check": "astro check && vue-tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "build": "npm run check && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/vue": "^7.1.2",
    "astro": "^7.4.2",
    "pixi.js": "^8.22.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.13"
  }
}
